/* Test: structures de contrôle */
int main(void){
    int x, result;
    x = 10;
    result = 0;

    if (x > 5) {
        result = 1;
    }

    if (x < 20) {
        result = result + 1;
    } else {
        result = 0;
    }

    while (x > 0) {
        x = x - 1;
        result = result + 1;
    }

    return result;
}
